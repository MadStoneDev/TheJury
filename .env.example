# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
# Public site URL — used for metadata, sitemap, robots, Stripe redirects, embed
# links and the /api/health uptime check. Must be reachable from the server.
NEXT_PUBLIC_APP_URL=https://thejury.app

# Health check (optional): a small table readable by the anon role, used to prove
# the database is answering. `demo_polls` suits this (public, has an `id`); leave
# unset to fall back to a PostgREST root probe.
HEALTH_TABLE=demo_polls

# Seed (required for /api/live-polls/seed — generate a random string)
SEED_SECRET=generate-a-random-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Pro monthly (A$9), Pro annual (A$90/yr), Pro lifetime one-off (A$199)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_LIFETIME_PRICE_ID=price_...
# Legacy Team price IDs — tier retired, kept only for existing subscribers
STRIPE_TEAM_PRICE_ID=price_...
STRIPE_TEAM_ANNUAL_PRICE_ID=price_...