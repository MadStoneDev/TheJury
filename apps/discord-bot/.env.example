# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id

# TheJury Supabase — the SERVICE ROLE key (the bot writes on behalf of many
# Discord users, so it bypasses RLS). Never ship this to the browser.
SUPABASE_URL=https://supabase.thejury.app
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used for "View full results" links and the /jury link page.
THEJURY_URL=https://thejury.app

# Optional: report /jury installs to GA4 (same property as the web app)
GA_MEASUREMENT_ID=G-XXXXXXX
GA_API_SECRET=your-mp-api-secret

# Optional: register slash commands to ONE guild for instant testing.
# Leave blank in production to register /jury globally.
DISCORD_TEST_GUILD_ID=

# Optional: post server-count stats to top.gg (from your bot's top.gg page).
TOPGG_TOKEN=
